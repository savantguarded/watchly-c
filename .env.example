TMDB_API_KEY=<your_tmdb_api_key>
REDIS_URL=redis://redis:6379/0
TOKEN_SALT=change-me # generate secure salt...

# app setup
APP_ENV="development"  # available values are ["development", "production"]
HOST_NAME=<your_addon_url>
PORT=8000
ALLOW_SIGNUPS=True  # False locks the instance to existing accounts

# redis
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECTIONS_THRESHOLD=100

# UPDATER
AUTO_UPDATE_CATALOGS=True
CATALOG_REFRESH_INTERVAL_SECONDS=21600 # 6*60*60 every ~6 hours

# Watchly C (all on by default; False restores stock Watchly behaviour)
NUVIO_MDBLIST_RATINGS=True  # Nuvio history + MDBList ratings when both are connected
WEIGHTED_ITEM_SEEDS=True    # daily "Because you watched/loved" seeds, weighted to recent high ratings
MIXED_ITEM_ROWS=True        # those rows mix movies and series instead of one set per type
WATCHED_TMDB_IDS=True       # drop watched titles before rows are cut to length (full rows for big histories)
FIXED_ROW_SLOTS=True        # always declare every theme and mixed row slot, so Nuvio keeps their home order
FILL_MISSING_TITLES=True    # look up Nuvio titles that arrive nameless, so no row reads "Because you watched this title"
DAILY_REWATCH=True          # "Watch it again" draws from a wider pool and is rebuilt by the daily refresh
RELEVANCE_RANKING=True      # "Because you watched" picks scored against the seed, with a rating floor
WIDE_THEME_ROWS=True        # genre and keyword rows are topped up to a full row, with the same rating floor
CONTEXT_ROWS=True           # seasonal and contextual rows (Spooky Season, Friday Night, Rainy Day, ...)
CROSS_ROW_DEDUPE=True       # a title shows in one row at a time; "Because you watched" rows claim first
QUALITY_TOP_PICKS=True       # Top Picks ranks by taste fit scaled by quality, sorts discover by rating, drops the popularity boost
MIXED_BASE_ROWS=True        # Top Picks, Creators and Watch it again are one row blending movies and series
RETIRE_ALL_BASED=True       # drops "Based on what you loved/liked", which Top Picks and "Because you" rows already cover
WEATHER_LATITUDE=6.5244     # Lagos; where the Rainy Day row checks for rain
WEATHER_LONGITUDE=3.3792
SHUFFLE_INTERVAL_HOURS=1    # shuffled rows reshuffle every N hours; 0 = stock (every request)
DAILY_UTC_OFFSET_HOURS=1  # Lagos; where "a day" starts for daily seeds and shuffles
CRON_SECRET=                # optional; locks /watchly-c/daily-refresh to Vercel's cron
INLINE_WARMUP=False         # warm up during the status poll; on by itself on Vercel (VERCEL=1)
